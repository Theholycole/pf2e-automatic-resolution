      {
        "id": "pf2e-resolution-core",
        "type": "module"
      }
    ],
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.5.0",
          "verified": "8.5.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/runtime.css"
  ],
  "socket": true,
  "packs": [
    {
      "name": "macros",
      "label": "PF2e Automatic Resolution Macros",
